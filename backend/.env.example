# MediGuard AI — Backend Environment Variables
# Copy this file to .env and fill in real values. Never commit .env —
# see .gitignore.

# ── App ──────────────────────────────────────────────────────────────
DEBUG=false
ENVIRONMENT=development

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. Leave blank to use
# the localhost dev defaults. In production, set this to your real
# frontend URL(s), e.g.:
# CORS_ORIGINS=https://mediguard-ai.vercel.app,https://app.mediguard.ai
CORS_ORIGINS=

# ── LLM Provider: groq | gemini | ollama ────────────────────────────
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant

# API Keys
# >>> REQUIRED for /ai/chat, /agents, /ayurveda/agent, and LLM fallbacks. <<<
# Get a free Groq key at https://console.groq.com
# Leave blank and those endpoints return a clear 503 error; everything
# else (prediction, SHAP, OCR, timeline, heatmap, PDF, prakriti, yoga,
# diet) still works without any LLM key at all.
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# LangSmith (optional — traces every LangChain call once both are set)
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=mediguard_ai

# MLflow
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Chroma (RAG vector store)
CHROMA_PERSIST_DIR=./data/chroma_db

# Storage
# MODEL_DIR is resolved relative to backend/ (e.g. "../models" = the
# project-root models/ directory where models/best_model.pkl ships —
# this is the default; only change it if you want models stored
# somewhere else).
MODEL_DIR=../models
UPLOAD_DIR=./data/uploads

# ML lifecycle
# false = load the shipped model and boot instantly (recommended)
# true  = retrain automatically whenever PSI drift exceeds DRIFT_THRESHOLD
RETRAIN_ON_DRIFT=false
DRIFT_THRESHOLD=0.20

# Production classifier algorithm: xgboost (default) | random_forest | logistic_regression
# See docs/MODEL_COMPARISON.md (generate/refresh with `python -m ml.baseline_comparison`)
# for a real accuracy/precision/recall/F1/ROC-AUC comparison of all three on this
# project's actual training data before changing this from the default.
ML_ALGORITHM=xgboost

# ── Auth / JWT ───────────────────────────────────────────────────────
# >>> REQUIRED in production. Generate one with:
#     python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_DB_PATH=./data/mediguard_users.db

# ── OTP / email verification (registration + password reset) ───────
OTP_EXPIRE_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_MAX=5
OTP_RATE_LIMIT_WINDOW_MINUTES=60
VERIFICATION_TOKEN_EXPIRE_SECONDS=900
RESET_TOKEN_EXPIRE_SECONDS=900

# Email delivery — leave SMTP_HOST blank to log OTP codes to the server
# console instead of sending real email (safe default for local dev).
# For production, point this at a real provider (SendGrid, SES SMTP,
# Postmark, etc.).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@mediguard.ai
SMTP_USE_TLS=true
